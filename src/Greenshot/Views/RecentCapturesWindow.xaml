<!-- 왕샷: the recent captures gallery, opened from the tray menu: thumbnails of the captures in the output folder -->
<Window x:Class="Greenshot.Views.RecentCapturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Greenshot.Base.Wpf;assembly=Greenshot.Base"
        Title="최근 캡처"
        Width="960"
        Height="660"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, Segoe UI Variable Display, Tahoma, Arial"
        FontSize="{wpf:FontSize 13}"
        Background="{Binding WindowBackgroundBrush}"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Greenshot.Base;component/Wpf/Styles/ListViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding CardBorderBrush}" Background="{Binding WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title bar -->
                <RowDefinition Height="Auto"/> <!-- Header with the folder and the buttons -->
                <RowDefinition Height="*"/>    <!-- The captures -->
                <RowDefinition Height="Auto"/> <!-- What the selection can do, and the status -->
            </Grid.RowDefinitions>

            <wpf:ThemedTitleBar Grid.Row="0" ShowThemeToggle="True"/>

            <Grid Grid.Row="1" Margin="18,14,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="최근 캡처" FontSize="{wpf:FontSize 18}" FontWeight="SemiBold" Foreground="{Binding TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText"
                               Margin="0,3,0,0"
                               Foreground="{Binding TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="새로 고침" Click="OnRefreshClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button x:Name="FolderButton" Content="저장 폴더 열기" Click="OnOpenFolderClick" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="14,0,14,0">
                <ListBox x:Name="CapturesList"
                         Style="{StaticResource ThemeListBox}"
                         ItemsSource="{Binding Captures}"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="OnSelectionChanged"
                         MouseDoubleClick="OnListMouseDoubleClick"
                         KeyDown="OnListKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Margin="4"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ThemeListBoxItem}">
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="204" Background="Transparent">
                                <StackPanel>
                                    <!-- The thumbnail, letterboxed in the card so tall page captures keep their shape -->
                                    <Border Height="122" CornerRadius="6" ClipToBounds="True"
                                            Background="{Binding DataContext.BadgeBackgroundBrush, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.CardBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <Style.Triggers>
                                                    <!-- The selected capture gets the accent color, so it stands out from the card background -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="BorderThickness" Value="3"/>
                                                        <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding FileName}"
                                               Margin="2,7,2,0"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding DataContext.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}"/>
                                    <TextBlock Text="{Binding DetailText}"
                                               Margin="2,2,2,2"
                                               FontSize="{wpf:FontSize 11}"
                                               Foreground="{Binding DataContext.TextSecondaryBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"
                           Foreground="{Binding TextSecondaryBrush}"
                           Text="아직 캡처가 없어요.&#10;PrintScreen 으로 캡처하면 여기에 모여요."/>
            </Grid>

            <Grid Grid.Row="3" Margin="18,10,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{Binding TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="편집기에서 열기" Click="OnOpenClick" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="CopyButton" Content="복사" Click="OnCopyClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="RevealButton" Content="폴더에서 보기" Click="OnRevealClick" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" IsEnabled="False"/>
                    <Button x:Name="DeleteButton" Content="삭제" Click="OnDeleteClick" Style="{StaticResource LightErrorButtonStyle}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
